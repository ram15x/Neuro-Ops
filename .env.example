# copy to .env. none of these are needed for the simulated demo.
ENV=development
# JWT_SECRET=   (leave unset on a laptop, set a long random value in production)
# DEFAULT_ADMIN_PASSWORD=   (required when ENV=production)
ENGINE_MODE=shadow
# real account only: sim (default) or cloudwatch. cloudwatch stays in shadow unless ENGINE_LIVE_ACTIONS=true
# ENGINE_SOURCE=cloudwatch
# ENGINE_LIVE_ACTIONS=false
# ENGINE_WARM_DAYS=3
AWS_REGION=ap-south-1
